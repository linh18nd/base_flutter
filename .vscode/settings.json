{
  "dart.flutterSdkPath": ".fvm/versions/3.50.0",
  "dart.projectSearchDepth": 5,
  "dart.enableSdkFormatter": true,
  "dart.lineLength": 80,
  "dart.analysisExcludedFolders": [
    "build",
    ".dart_tool"
  ],
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.rulers": [80]
  },
  // Show generated files nested under their source file in the explorer.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.dart": "${capture}.g.dart, ${capture}.freezed.dart",
    "pubspec.yaml": "pubspec.lock, analysis_options.yaml, build.yaml, slang.yaml, mason.yaml, .metadata",
    "README.md": "FLAVORS.md",
    ".gitignore": ".gitattributes, .fvmrc"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.dart_tool/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/*.g.dart": true,
    "**/*.freezed.dart": true
  },
  "java.configuration.updateBuildConfiguration": "disabled"
}
